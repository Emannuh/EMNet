# ─────────────────────────────────────────────────────────────────────────────
# NetSuite-ISP  —  Environment Variables
# Copy this file to .env and fill in real values. NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Django ────────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database (shared Postgres instance) ──────────────────────────────────────
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=netsuite_isp
POSTGRES_USER=netsuite
POSTGRES_PASSWORD=change-me

# Full DSN built from the above (used by Django settings)
DATABASE_URL=postgres://netsuite:change-me@db:5432/netsuite_isp

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# Celery broker / result backend
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── FreeRADIUS / AAA ─────────────────────────────────────────────────────────
RADIUS_DB_HOST=db
RADIUS_DB_PORT=5432
RADIUS_DB_NAME=radius
RADIUS_DB_USER=radius
RADIUS_DB_PASSWORD=change-me
RADIUS_SECRET=change-me-radius-shared-secret

# ── M-Pesa Daraja API ─────────────────────────────────────────────────────────
MPESA_ENVIRONMENT=sandbox          # sandbox | production
MPESA_CONSUMER_KEY=change-me
MPESA_CONSUMER_SECRET=change-me
MPESA_SHORTCODE=174379             # Safaricom sandbox shortcode
MPESA_PASSKEY=change-me
MPESA_CALLBACK_BASE_URL=https://yourdomain.com

# ── Captive Portal FastAPI service ────────────────────────────────────────────
PORTAL_SECRET_KEY=change-me-portal-jwt-secret
PORTAL_HOST=0.0.0.0
PORTAL_PORT=8001

# Internal URL Django uses to call the portal service (docker network)
PORTAL_INTERNAL_URL=http://portal:8001

# ── Email (optional — for alerts & invoices) ─────────────────────────────────
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=no-reply@example.com
EMAIL_HOST_PASSWORD=change-me

# ── Super-admin seed account (created by init script) ────────────────────────
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=change-me

# ── Sentry (optional — error tracking) ───────────────────────────────────────
SENTRY_DSN=
